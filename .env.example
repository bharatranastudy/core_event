# Site & Company Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=Core Events
NEXT_PUBLIC_CITY_REGION=Bengaluru, India
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourcompany.com
NEXT_PUBLIC_CONTACT_PHONE=+91 98000 00000

# Supabase (Database, Storage, Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Access Control (Only this Supabase Auth email can access /admin)
ADMIN_EMAIL=owner@yourcompany.com

# Email Notifications (Resend)
ADMIN_NOTIFICATION_EMAIL=owner@yourcompany.com
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Core Events <noreply@yourcompany.com>
