PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas or Local MongoDB)
# Example Local: mongodb://127.0.0.1:27017/connectsphere
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/connectsphere
MONGO_URI=

# JWT Signing Secret (Use a strong random string in production)
JWT_SECRET=

# Optional Seed Script Configuration
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
